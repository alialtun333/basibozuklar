rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Herkes okuyabilir
    match /{document=**} {
      allow read: if true;
    }

    // Users: Herkes oluşturabilir/güncelleyebilir
    match /users/{email} {
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Games, Surveys, Announcements, Messages, Badges, Inventory, 
    // Notifs, UserBadges, ZimmetLogs, GameSummaries, Photos
    // Tüm koleksiyonlar için aynı kural
    match /{collection}/{docId} {
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}